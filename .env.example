# ---------------------------------------------------------------------------
# ANAV Global — environment
# Copy to .env.local and fill in. .env.local is gitignored; never commit keys.
# ---------------------------------------------------------------------------

# Canonical origin for this deploy. Feeds the canonical tag, og:url, the
# sitemap, robots.txt and the Organization @id. Set it per environment so a
# preview build does not canonicalise itself to production.
# Must include the protocol — https://anavglobal.com, not anavglobal.com
# (lib/origin.ts repairs a bare host, but set it properly).
NEXT_PUBLIC_SITE_URL=https://anavglobal.com

# Supabase — Dashboard > Project Settings > API
# The anon key is safe in the browser: every table is protected by row-level
# security, and the policies in supabase/migrations/0001_init.sql are what
# actually enforce access. Never put the service_role key in a NEXT_PUBLIC_ var.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
